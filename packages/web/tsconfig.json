{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // vite.config.ts imports ./pwa.config.ts with the extension so Vite's `configLoader: 'native'`
    // (the default in a future major) can load the config. TypeScript only allows that with this
    // flag, which is why the two go together.
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "svelte",
      "vite/client",
      "vite-plugin-pwa/client"
    ]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "pwa.config.ts",
    "pwa-assets.config.ts"
  ]
}
