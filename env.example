# Copy to `.env` on the server (`cp env.example .env`) and fill in the values.
# `.env` is git-ignored and never baked into the image.

# Organizer secret for /admin. At least 12 characters; the server refuses to start otherwise.
# Generate one with: openssl rand -base64 24
ADMIN_PIN=replace-me-with-a-long-random-value

# Public host name Caddy serves and gets the HTTPS certificate for.
# With a domain: la-sala.example.com
# Without one, use the server IP with dashes: 203-0-113-10.sslip.io
SITE_ADDRESS=203-0-113-10.sslip.io
